# Only code, the README and templates are committed. Music, generated data, caches, secrets and
# personal settings never are.

# Python and system
__pycache__/
*.pyc
.DS_Store
*.tmp

# Virtual environments and Essentia models (downloaded; ~600 MB)
.venv/
.venv-essentia/
models/

# Personal settings (template: config.example.env)
config.env
.env

# Generated data, caches, locks and secrets (phone tokens, Spotify login), and your own
# artist_genres.csv: everything in data/ except the example
data/*
!data/artist_genres.example.csv

# Internal development notes and Claude Code workflow (kept locally, not published)
docs/
CLAUDE.md
.claude/

# Android signing keys
*.jks
*.keystore

# Music and trash
MP3 Songs/
Papelera MP3/
MP3 Player Card/

# Playlists generated by the pipeline (rebuilt by scripts/runner.sh)
Playlists/

# Logs
logs/

# Android app: build output, Gradle caches and local SDK paths
*.apk
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
android/local.properties
