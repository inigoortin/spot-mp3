# Personal settings. Copy this file to config.env (never committed) and fill it in.
# Environment variables with the same name take precedence.

# Client ID of your Spotify app (https://developer.spotify.com/dashboard), with redirect URI
# http://127.0.0.1:8888/callback. Required.
SPOTIFY_CLIENT_ID=

# Python interpreters used by scripts/runner.sh. Leave empty to use the defaults:
# .venv/bin/python and .venv-essentia/bin/python inside this folder.
PYTHON=
PYTHON_ESSENTIA=
